{
	"name": "Lunit Game Fixture",
	"globIgnorePaths": ["out/shared/ignored.luau", "out/server/luneOnly.test.luau", "out/server/mixedTags.test.luau"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"Shared": {
				"$path": { "optional": "out/shared" }
			},
			"NotBuiltYet": {
				"$path": { "optional": "out/does-not-exist" }
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": { "optional": "out/server" }
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": { "optional": "out/client" }
				}
			}
		}
	}
}
