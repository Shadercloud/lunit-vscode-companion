-- Stands in for @rbxts/lunit in this fixture: enough of
-- TestRunner:fromClasses(...):run{ reporter }:expect() for the generated
-- runner's lunitRunClass helper to drive it and read results back through
-- the onTestEnd reporter hook, modelled on the real runner's rules:
--
-- - a class with `new` gets one instance per run, otherwise the class table
--   itself is the receiver (the older fixture modules have no constructor);
-- - lifecycle hooks come from each method's `options.lifecycles`
--   ("BeforeAll", "AfterAll", "BeforeEach", "AfterEach");
-- - `options.order` sorts tests (default 9999), then the name;
-- - `options.cases` runs one result per row, labelled "name (a, b)";
-- - `options.only` focuses, `options.disabled` skips, class-level too;
-- - `options.displayName` names the result.
local Lunit = {}

local DEFAULT_ORDER = 9999

local TestRunner = {}
TestRunner.__index = TestRunner

function TestRunner.fromClasses(_, classes)
	return setmetatable({ classes = classes }, TestRunner)
end

local function hooksOf(cls, lifecycle)
	local hooks = {}
	for name, method in cls["lunit:method:test"] or {} do
		if table.find(method.options.lifecycles or {}, lifecycle) ~= nil then
			table.insert(hooks, cls[name])
		end
	end
	return hooks
end

local function runHooks(cls, instance, lifecycle)
	for _, hook in hooksOf(cls, lifecycle) do
		hook(instance)
	end
end

local function isDisabled(metadata)
	return type(metadata) == "table" and type(metadata.disabled) == "table" and metadata.disabled.value == true
end

local function label(name, method, row)
	local base = method.options.displayName or name
	if row == nil then
		return base
	end
	local parts = {}
	for _, value in row do
		table.insert(parts, tostring(value))
	end
	return base .. " (" .. table.concat(parts, ", ") .. ")"
end

function TestRunner.run(self, options)
	local result = { numTests = 0, numTestsPassed = 0, numTestsFailed = 0, numTestsSkipped = 0 }
	local function report(name, passed, skipped, message)
		result.numTests += 1
		if skipped then
			result.numTestsSkipped += 1
		elseif passed then
			result.numTestsPassed += 1
		else
			result.numTestsFailed += 1
		end
		options.reporter:onTestEnd(name, {
			label = name,
			passed = passed,
			skipped = skipped,
			elapsedTimeMs = 0,
			errorMessage = message,
		})
	end
	for _, cls in self.classes do
		local instance = if type(cls.new) == "function" then cls.new() else cls
		local tests = {}
		for name, method in cls["lunit:method:test"] or {} do
			if method.options.isTest then
				table.insert(tests, { name = name, method = method })
			end
		end
		local focused = {}
		for _, test in tests do
			if test.method.options.only then
				table.insert(focused, test)
			end
		end
		if #focused > 0 then
			tests = focused
		end
		table.sort(tests, function(a, b)
			local orderA = a.method.options.order or DEFAULT_ORDER
			local orderB = b.method.options.order or DEFAULT_ORDER
			if orderA == orderB then
				return a.name < b.name
			end
			return orderA < orderB
		end)
		local classDisabled = isDisabled(cls["lunit:class"])
		if not classDisabled then
			runHooks(cls, instance, "BeforeAll")
		end
		for _, test in tests do
			local rows = test.method.options.cases
			local invocations = if type(rows) == "table" and #rows > 0 then rows else { false }
			for _, row in invocations do
				local args = if row == false then nil else row
				local name = label(test.name, test.method, args)
				if classDisabled or isDisabled(test.method.options) then
					local metadata = if classDisabled then cls["lunit:class"] else test.method.options
					report(name, false, true, metadata.disabled.message)
				else
					runHooks(cls, instance, "BeforeEach")
					local ok, err = pcall(function()
						if args ~= nil then
							return cls[test.name](instance, table.unpack(args))
						end
						return cls[test.name](instance)
					end)
					runHooks(cls, instance, "AfterEach")
					report(name, ok, false, if ok then nil else tostring(err))
				end
			end
		end
		if not classDisabled then
			runHooks(cls, instance, "AfterAll")
		end
	end
	return {
		expect = function()
			return result
		end,
	}
end

Lunit.TestRunner = setmetatable({}, { __index = TestRunner })

return Lunit
